# Clerk Authentication
# Get your keys from https://dashboard.clerk.com -> API Keys
# REPLACE WITH YOUR ACTUAL KEYS FROM CLERK DASHBOARD
# For production: use production keys (pk_live_* / sk_live_*)
# For development: use test keys (pk_test_* / sk_test_*)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=replace_with_your_publishable_key
CLERK_SECRET_KEY=replace_with_your_secret_key

# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/pulsechat"

# Object Storage for voice messages (S3-compatible)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=pulsechat
STORAGE_ACCESS_KEY=replace_with_your_access_key
STORAGE_SECRET_KEY=replace_with_your_secret_key
STORAGE_USE_SSL=false

# Realtime / WebSocket server
# For local development: ws://localhost:3001
# For production: wss://your-websocket-server.example.com (requires separate WebSocket server deployment)
# If not set or set to localhost, real-time features will be disabled
NEXT_PUBLIC_REALTIME_URL=ws://localhost:3001

# Legacy variable (deprecated, use NEXT_PUBLIC_REALTIME_URL)
REALTIME_SERVER_URL=ws://localhost:3001

# WebRTC TURN server
# Required for production voice/video calls
# Get credentials from Twilio, Xirsys, or self-hosted coturn
TURN_SERVER_URL=turn:turn.example.com:3478
TURN_USERNAME=replace_with_your_turn_username
TURN_CREDENTIAL=replace_with_your_turn_credential

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development